{
  "manifest_version": 3,
  "name": "Developer Dashboard",
  "version": "1.0.0",
  "description": "A beautiful new tab dashboard extension.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "sessions",
    "tabs",
    "bookmarks",
    "unlimitedStorage"
  ]
}
